# FPS Smart Management System
# Copy this to .env.local. Never commit .env.local.

# Default FPS Configuration (used only as a display fallback before login)
NEXT_PUBLIC_DEFAULT_DIST_CODE=1512
NEXT_PUBLIC_DEFAULT_FPS_ID=151209500212

# --- Backend API (fps-manager-ration-backend, Express + Supabase) ---
# URL of the deployed/local fps-manager-ration-backend service.
BACKEND_URL=http://localhost:4000
# Must match INTERNAL_API_KEY in the backend's own .env.
INTERNAL_API_KEY=

# --- Auth (NextAuth / Auth.js v5) ---

# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
