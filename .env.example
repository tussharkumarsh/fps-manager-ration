# FPS Smart Management System
# Copy this to .env.local. Never commit .env.local.

# Default FPS Configuration (used only as a display fallback before login)
NEXT_PUBLIC_DEFAULT_DIST_CODE=1512
NEXT_PUBLIC_DEFAULT_FPS_ID=151209500212

# --- Vercel Blob (durable database: .xlsx files) ---
# From the Vercel dashboard: Storage -> Create Database -> Blob -> copy the
# "BLOB_READ_WRITE_TOKEN" (or run `vercel env pull` after linking the
# project locally). Required for both local dev and deployed environments.
BLOB_READ_WRITE_TOKEN=

# --- Auth (NextAuth / Auth.js v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
